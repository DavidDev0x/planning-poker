# Copie para .env (desenvolvimento local) ou cadastre em Vercel → Settings → Environment Variables.
# Supabase → Project Settings → API (ou "API Keys").
SUPABASE_URL=https://seu-projeto.supabase.co
# Chave pública (anon ou publishable "sb_publishable_..."). Vai para o navegador.
SUPABASE_ANON_KEY=sua-chave-anon-aqui
# Chave secreta (service_role ou secret "sb_secret_..."). NUNCA exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-aqui
